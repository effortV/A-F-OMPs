# Core
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501

# SiliconFlow: never commit the real key
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
# Only contextual chat/RAG uses V4-Pro. Literature extraction and background tasks keep LLM_MODEL above.
CHAT_LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro
LLM_TEMPERATURE=0.1

# Literature APIs. OpenAlex requires a free key since 2026-02-13. Crossref needs no key.
OPENALEX_API_KEY=
OPENALEX_EMAIL=
UNPAYWALL_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
ELSEVIER_API_KEY=
# Optional: Elsevier-issued server-side Institutional Token. A school portal
# username/password is NOT an API credential and must never be placed here.
ELSEVIER_INSTTOKEN=

# Public full text fallback: direct official/repository PDF or HTML only.
# It respects robots.txt, rejects private-network URLs and never bypasses login/paywalls.
DIRECT_WEB_FETCH=true
DIRECT_WEB_RESPECT_ROBOTS=true
DIRECT_WEB_MIN_INTERVAL_SECONDS=1.0
DIRECT_WEB_MAX_BYTES=104857600
DIRECT_HTML_MIN_CHARS=3000

# Local development defaults
DATABASE_URL=sqlite:///./data/runtime/nf_agent.db
USE_RQ=false
PRIORITY_QUEUE_NAME=nf-priority
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=nf-literature

# Object persistence: local or minio
STORAGE_BACKEND=local
STORAGE_ROOT=./data/runtime/objects
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nfadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_SECURE=false
MINIO_BUCKET=nf-literature

# Neo4j is optional in local mode; SQL facts are used as a retrieval fallback.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Chroma uses an embedded persistent client when CHROMA_HOST is empty.
CHROMA_PATH=./data/runtime/chroma
CHROMA_HOST=
CHROMA_PORT=8000
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
ALLOW_EMBEDDING_DOWNLOAD=false
ALLOW_EMBEDDING_FALLBACK=false
HF_ENDPOINT=https://hf-mirror.com

# Parsing. MinerU command uses {input} and {output} placeholders, for example:
# MINERU_COMMAND=mineru -p {input} -o {output}
MINERU_COMMAND=
GROBID_URL=http://localhost:8070
PARSER_TIMEOUT_SECONDS=600
# Docker Hub 在当前网络不可达时可使用镜像代理；留空/改为 docker.io 可恢复官方源
DOCKER_REGISTRY_PREFIX=docker.1ms.run
PYTHON_BASE_IMAGE=docker.1ms.run/library/python:3.11-slim
PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
